aws_region                = "ap-south-1"
env                       = "prod"
cluster_name              = "REPLACE_WITH_PRODUCTION_CLUSTER_NAME"
k8s_version               = "1.31"
subnet_ids                = ["subnet-REPLACE_A", "subnet-REPLACE_B"]
security_group_ids        = ["sg-REPLACE_WITH_CLUSTER_SECURITY_GROUP"]
enabled_cluster_log_types = ["api", "audit", "authenticator", "controllerManager", "scheduler"]
public_access_cidrs       = ["203.0.113.0/24"]
endpoint_public_access    = false
endpoint_private_access   = true
availability_zone         = "ap-south-1a"
node_group_name            = "REPLACE_WITH_PRODUCTION_NODE_GROUP"
instance_types             = ["REPLACE_WITH_APPROVED_INSTANCE_TYPE"]
desired_size               = 2
min_size                   = 2
max_size                   = 6
tags = {
  Environment = "prod"
  Project     = "REPLACE_WITH_PROJECT"
}
vpc_cidr_block       = "10.50.0.0/16"
availability_zones   = ["ap-south-1a", "ap-south-1b"]
public_subnet_cidrs  = ["10.50.1.0/24", "10.50.2.0/24"]
private_subnet_cidrs = ["10.50.3.0/24", "10.50.4.0/24"]
platform_bucket_name  = "REPLACE_WITH_GLOBALLY_UNIQUE_PROD_BUCKET"
kms_alias_name        = "smamida-prod"
kms_description       = "Production platform encryption key"
log_group_name        = "/smamida/prod/platform"
log_retention_days    = 365
queue_name            = "smamida-prod-events"
secret_name           = "smamida/prod/application"
secret_description    = "Production application secret container"