aws_region                = "ap-south-1"
env                       = "test"
cluster_name              = "REPLACE_WITH_TEST_CLUSTER_NAME"
k8s_version               = "1.31"
subnet_ids                = ["subnet-REPLACE_A", "subnet-REPLACE_B"]
security_group_ids        = ["sg-REPLACE_WITH_CLUSTER_SECURITY_GROUP"]
enabled_cluster_log_types = ["api", "audit", "authenticator", "controllerManager", "scheduler"]
public_access_cidrs       = ["203.0.113.0/24"]
endpoint_public_access    = true
endpoint_private_access   = true
availability_zone         = "ap-south-1a"
node_group_name            = "REPLACE_WITH_TEST_NODE_GROUP"
instance_types             = ["t3.medium"]
desired_size               = 1
min_size                   = 1
max_size                   = 3
tags = {
  Environment = "test"
  Project     = "REPLACE_WITH_PROJECT"
}
vpc_cidr_block       = "10.60.0.0/16"
availability_zones   = ["ap-south-1a", "ap-south-1b"]
public_subnet_cidrs  = ["10.60.1.0/24", "10.60.2.0/24"]
private_subnet_cidrs = ["10.60.3.0/24", "10.60.4.0/24"]
platform_bucket_name  = "REPLACE_WITH_GLOBALLY_UNIQUE_TEST_BUCKET"
kms_alias_name        = "smamida-test"
kms_description       = "Test platform encryption key"
log_group_name        = "/smamida/test/platform"
log_retention_days    = 60
queue_name            = "smamida-test-events"
secret_name           = "smamida/test/application"
secret_description    = "Test application secret container"
